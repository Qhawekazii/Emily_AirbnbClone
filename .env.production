# Production environment variables
# Set these in your Heroku dashboard under Settings > Config Vars
# DO NOT commit real values — this file shows the required keys only

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airbnb?retryWrites=true&w=majority
JWT_SECRET=<generate_a_strong_random_secret_here>
NODE_ENV=production
